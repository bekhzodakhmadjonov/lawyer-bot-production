# Production Environment Configuration for Lawyer-Bot-Production

# Environment
ENVIRONMENT=production

# Database (PostgreSQL - Self-hosted on Oracle Cloud)
POSTGRES_PASSWORD=your_secure_postgres_password
# DATABASE_URL is automatically set by docker-compose, but you can override if needed
# DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password@postgres:5432/lawyer_bot

# Redis (for caching and rate limiting)
REDIS_URL=redis://redis:6379/0

# AI Provider
OPENAI_API_KEY=

# Telegram Bot Config
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://yourdomain.example.com
TELEGRAM_LEAD_CHAT_ID=
REQUIRED_CHANNEL_USERNAME=
REQUIRED_CHANNEL_ID=

# Domain Configuration (for Caddy SSL)
DOMAIN=yourdomain.example.com

# Application Port (default: 8000)
APP_PORT=8000
