# Production Environment Configuration for Lawyer-Bot-Production v2

# Application
APP_PORT=8000
ENVIRONMENT=local  # local, production

# AI Provider (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Telegram Bot Config
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
TELEGRAM_WEBHOOK_URL=https://your-domain.com
TELEGRAM_LEAD_CHAT_ID=-100xxxxxxxxxx
REQUIRED_CHANNEL_USERNAME=your_channel_username
REQUIRED_CHANNEL_ID=-100xxxxxxxxxx

# Database
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_USE_SSL=false  # Set to true for external hosted Postgres

# Domain
DOMAIN=your-domain.com

# Redis
REDIS_URL=redis://redis:6379/0
